{
  // Cloudflare Worker: API unter /api/*, alles andere ist die App aus ./dist
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supermarkt-app",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Zwischenspeicher für Angebote, eingelesene Prospekte und das Tageslimit.
  // Fest eingetragen, damit bei jedem Update derselbe Speicher verwendet wird.
  "kv_namespaces": [{ "binding": "CACHE", "id": "9d11a6dcb1e041d4894d465974461c4b" }],
  // Alle 30 Minuten prüfen, ob es neue EDEKA-Prospekte zum Einlesen gibt
  "triggers": { "crons": ["*/30 * * * *"] },
  "vars": {
    "MODEL": "claude-sonnet-5-5",
    "EXTRACT_MODEL": "claude-sonnet-5-5",
    "DAILY_RECIPE_LIMIT": "15",
    // Obergrenze für KI-Kosten pro Monat (Rezepte + Prospekte), in US-Dollar
    "MONTHLY_BUDGET_USD": "8"
  },
  "observability": { "enabled": true }
}
