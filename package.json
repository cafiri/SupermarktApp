{
  "name": "supermarkt-app",
  "version": "1.0.0",
  "description": "Rezepte aus Supermarkt-Angeboten",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "dev:api": "wrangler dev",
    "typecheck": "tsc -p tsconfig.json && tsc -p worker/tsconfig.json",
    "test": "esbuild test/normalize.test.ts --bundle --platform=node --log-level=warning | node"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "esbuild": "^0.23.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "wrangler": "^4.151.1"
  },
  "private": true,
  "type": "module"
}
